#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RT="${CONTAINER_RUNTIME:-$(command -v podman >/dev/null 2>&1 && echo podman || echo docker)}"

echo "==> [pre-push] Lint & tests (containerized)..."
make lint
make test

echo "==> [pre-push] Image build & container smoke check..."
IMAGE_TAG="secret-santa:pre-push"
CONTAINER_NAME="santa-smoke-$$"

cleanup() {
  "$RT" rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
}
trap cleanup EXIT

"$RT" build -t "$IMAGE_TAG" .

"$RT" run -d --name "$CONTAINER_NAME" \
  -p 127.0.0.1:0:8080 \
  -e APP_ENV=development \
  -e APP_BASE_URL=http://localhost:8080 \
  "$IMAGE_TAG" >/dev/null

HOST_PORT="$("$RT" port "$CONTAINER_NAME" 8080/tcp | head -n 1 | awk -F: '{print $NF}')"

healthy=0
for _ in $(seq 1 15); do
  if curl -fsS "http://127.0.0.1:${HOST_PORT}/api/health" >/dev/null 2>&1; then
    healthy=1
    break
  fi
  sleep 1
done

if [ "$healthy" -ne 1 ]; then
  echo "ERROR: Container failed healthcheck" >&2
  "$RT" logs "$CONTAINER_NAME" >&2 || true
  exit 1
fi

echo "==> [pre-push] All checks passed."
