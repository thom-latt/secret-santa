#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> [pre-push] Frontend typecheck, tests & build..."
npm --prefix web run typecheck
npm --prefix web test
npm --prefix web run build

echo "==> [pre-push] Backend vet & tests..."
go vet ./...
go test -race ./...

echo "==> [pre-push] Docker build & container smoke check..."
IMAGE_TAG="secret-santa:pre-push"
CONTAINER_NAME="santa-smoke-$$"

cleanup() {
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker build -t "$IMAGE_TAG" .

docker run -d --name "$CONTAINER_NAME" \
  -p 127.0.0.1:0:8080 \
  -e APP_ENV=development \
  -e APP_BASE_URL=http://localhost:8080 \
  "$IMAGE_TAG" >/dev/null

HOST_PORT="$(docker port "$CONTAINER_NAME" 8080/tcp | head -n 1 | awk -F: '{print $NF}')"

healthy=0
for _ in $(seq 1 15); do
  if curl -fsS "http://127.0.0.1:${HOST_PORT}/api/health" >/dev/null 2>&1; then
    healthy=1
    break
  fi
  sleep 1
done

if [ "$healthy" -ne 1 ]; then
  echo "ERROR: Docker container failed healthcheck" >&2
  docker logs "$CONTAINER_NAME" >&2 || true
  exit 1
fi

echo "==> [pre-push] All checks passed."
