# ==============================================================================
# Secret Santa — Environment Configuration Example
# Copy this file to .env and adjust values before deploying.
# ==============================================================================

# Application environment: "development" (console mock emails) or "production" (SMTP)
APP_ENV=development

# HTTP listen address inside the container
PORT=8080

# Public base URL used to generate absolute magic links in emails (no trailing slash)
# In development, leave commented out to automatically use http://localhost:$PORT
# APP_BASE_URL=https://santa.example.com

# Path to the persistent SQLite database file
DB_PATH=./data/secret-santa.db

# Super Administrator credentials for /superadmin back-office
# Run `make set-password` or `./secret-santa set-password` to set or update SUPER_ADMIN_PASSWORD_HASH
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD_HASH=pbkdf2_sha256:210000:00000000000000000000000000000000:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Secret key used to sign the Super Admin HttpOnly session cookie (auto-generated if empty in dev, required in production)
SESSION_SECRET=change-me-32-bytes-minimum-secret-key

# ==============================================================================
# SMTP Configuration (Used ONLY when APP_ENV=production)
# In APP_ENV=development, no network SMTP connection is ever opened.
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=santa@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Secret Santa <santa@example.com>

# TLS mode: "starttls" (port 587), "tls" (implicit TLS, port 465), or "none" (port 25 / local relay)
SMTP_TLS_MODE=starttls
